<Window x:Class="VPS3Drive.App.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage Account" Height="540" Width="560" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account Name:" VerticalAlignment="Center" />
                    <TextBox x:Name="AccountNameBox" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Account Type:" VerticalAlignment="Center" />
                    <ComboBox x:Name="AccountTypeBox" Grid.Row="2" Grid.Column="1" Height="26" SelectionChanged="AccountTypeBox_SelectionChanged">
                        <ComboBoxItem Content="Amazon S3" Tag="AmazonS3" IsSelected="True" />
                        <ComboBoxItem Content="S3 Compatible Storage" Tag="S3Compatible" />
                        <ComboBoxItem Content="AWS Config / Credentials File" Tag="AwsConfigFile" />
                    </ComboBox>
                </Grid>

                <GroupBox x:Name="KeysGroup" Header="Credentials">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Access Key ID:" VerticalAlignment="Center" />
                        <TextBox x:Name="AccessKeyBox" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Secret Access Key:" VerticalAlignment="Center" />
                        <PasswordBox x:Name="SecretKeyBox" Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="ConfigFileGroup" Header="AWS Config / Credentials" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Config or Credentials File:" VerticalAlignment="Center" />
                            <TextBox x:Name="ConfigFileBox" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            <Button Grid.Row="0" Grid.Column="2" Content="..." Width="30" Height="26" Margin="6,0,0,0" Click="BrowseConfigFile_Click" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="Leave empty to use AWS_CONFIG_FILE or AWS_SHARED_CREDENTIALS_FILE." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Profile:" VerticalAlignment="Center" />
                            <TextBox x:Name="ProfileBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="Leave empty to use AWS_PROFILE or default." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Endpoint &amp; Advanced Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="REST Endpoint:" VerticalAlignment="Center" />
                        <TextBox x:Name="RestEndpointBox" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Amazon S3 Compatible API endpoint, e.g. https://s3.us-east-1.wasabisys.com" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default Region:" VerticalAlignment="Center" />
                        <TextBox x:Name="RegionBox" Grid.Row="2" Grid.Column="1" Text="us-east-1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Region-specific Endpoint:" VerticalAlignment="Center" />
                        <TextBox x:Name="RegionEndpointBox" Grid.Row="4" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Optional template with {region-code}, e.g. s3.{region-code}.amazonaws.com" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Signature Version:" VerticalAlignment="Center" />
                        <ComboBox x:Name="SignatureBox" Grid.Row="6" Grid.Column="1" Height="26">
                            <ComboBoxItem Content="Signature V4 (default)" Tag="V4" IsSelected="True" />
                            <ComboBoxItem Content="Signature V2" Tag="V2" />
                        </ComboBox>

                        <CheckBox x:Name="UseSslBox" Grid.Row="8" Grid.Column="1" Content="Use secure transfer (SSL/TLS)" IsChecked="True" />
                        <CheckBox x:Name="PathStyleBox" Grid.Row="10" Grid.Column="1" Content="Use path-style addressing" />
                    </Grid>
                </GroupBox>

                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,4,2,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="TestButton" Content="Test Connection" Style="{StaticResource DialogButtonStyle}" DockPanel.Dock="Left" Click="TestButton_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
