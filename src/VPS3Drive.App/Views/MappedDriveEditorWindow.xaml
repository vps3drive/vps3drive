<Window x:Class="VPS3Drive.App.MappedDriveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Mapped Drive" Height="620" Width="580" MinWidth="540" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White">
            <TabItem Header="Mapped Drive">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Storage account:" VerticalAlignment="Center" />
                            <ComboBox x:Name="AccountBox" Grid.Row="0" Grid.Column="1" Height="26" DisplayMemberPath="Name" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Edit accounts..." Margin="6,0,0,0" Padding="8,3" Click="EditAccounts_Click" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Amazon S3 bucket:" VerticalAlignment="Center" />
                            <TextBox x:Name="BucketBox" Grid.Row="2" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Padding="8,3" Click="BrowseBuckets_Click" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="Bucket name and optional path, for example bucket-name/path/"
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Mapped drive letter:" VerticalAlignment="Center" />
                            <ComboBox x:Name="DriveLetterBox" Grid.Row="6" Grid.Column="1" Width="90" HorizontalAlignment="Left" Height="26" />
                        </Grid>

                        <GroupBox Header="Drive Type &amp; Options">
                            <StackPanel>
                                <RadioButton x:Name="NetworkDriveRadio" Content="Mount as Network Drive (recommended)" IsChecked="True" Margin="0,2,0,6" />
                                <RadioButton x:Name="RemovableDriveRadio" Content="Mount as Removable Drive" Margin="0,0,0,8" />
                                <CheckBox x:Name="ReadOnlyBox" Content="Mount as read-only media" Margin="0,0,0,6" />
                                <CheckBox x:Name="AutoMountBox" Content="Mount drive automatically on startup" IsChecked="True" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="138" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume label:" VerticalAlignment="Center" />
                                    <TextBox x:Name="VolumeLabelBox" Grid.Column="1" Height="26" VerticalContentAlignment="Center" Padding="4,0" />
                                </Grid>
                                <TextBlock Text="Leave empty to use auto-generated drive label." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="138,4,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced Drive Properties">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <GroupBox Header="Storage Settings">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Default storage class for new files:" VerticalAlignment="Center" />
                                    <ComboBox x:Name="StorageClassBox" Grid.Column="1" Height="26" IsEditable="True" ToolTip="Select a preset storage class or type a custom value">
                                        <ComboBoxItem Content="STANDARD" IsSelected="True" />
                                        <ComboBoxItem Content="STANDARD_IA" />
                                        <ComboBoxItem Content="ONEZONE_IA" />
                                        <ComboBoxItem Content="INTELLIGENT_TIERING" />
                                        <ComboBoxItem Content="GLACIER" />
                                        <ComboBoxItem Content="DEEP_ARCHIVE" />
                                        <ComboBoxItem Content="COLD" />
                                        <ComboBoxItem Content="REDUCED_REDUNDANCY" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="SseAes256Box" Content="Server-side encryption (AES-256)" Margin="0,2,0,6" />
                                <CheckBox x:Name="TransferAccelBox" Content="Enable Transfer Acceleration" Margin="0,0,0,6" />
                                <CheckBox x:Name="RequesterPaysBox" Content="Requester Pays" Margin="0,0,0,2" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Caching">
                            <StackPanel>
                                <CheckBox x:Name="CacheFileInfoBox" Content="Enable file information caching (reduces the number of requests)" IsChecked="True" Margin="0,2,0,6" />
                                <CheckBox x:Name="CacheDirBox" Content="Enable directory listings caching" IsChecked="True" Margin="0,0,0,6" />
                                <CheckBox x:Name="CacheReadBox" Content="Cache the READ requests for files smaller than (MB):" IsChecked="True" Margin="0,0,0,4" />
                                <TextBox x:Name="CacheReadMaxBox" Text="32" Width="80" HorizontalAlignment="Left" Margin="20,0,0,8" Height="24" Padding="4,0" />

                                <CheckBox x:Name="PrefetchBox" Content="Enable prefetching of files smaller than (MB):" Margin="0,0,0,4" />
                                <TextBox x:Name="PrefetchMaxBox" Text="8" Width="80" HorizontalAlignment="Left" Margin="20,0,0,8" Height="24" Padding="4,0" />

                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="290" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Limit size of cached READ requests on disk (MB):" VerticalAlignment="Center" />
                                    <TextBox x:Name="DiskCacheLimitBox" Grid.Column="1" Text="512" Height="24" Padding="4,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="290" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Limit time to live of cached items (seconds):" VerticalAlignment="Center" />
                                    <TextBox x:Name="CacheTtlBox" Grid.Column="1" Text="300" Height="24" Padding="4,0" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Soft Delete &amp; Trash Recovery" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="SoftDeleteBox" Content="Move deleted files to Trash folder instead of permanent delete" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trash folder prefix:" VerticalAlignment="Center" />
                                    <TextBox x:Name="TrashPrefixBox" Grid.Column="1" Text=".trash" Height="24" Padding="4,0" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
